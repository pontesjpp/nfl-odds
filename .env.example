# Template de variáveis de ambiente (Preencha com sua chave no servidor ou .env local)
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"
GEMINI_MODEL="gemini-3.5-flash-lite"
PORT=8000

# Segurança / Demonstração Pública (Cloudflare)
# Se 'true', bloqueia qualquer rota que modifique a base de dados (apostas, liquidações, deleções)
READ_ONLY_MODE="true"
ADMIN_SECRET="" # Opcional: Chave secreta para autorizar modificações via header 'x-admin-secret'
