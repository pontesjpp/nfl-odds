# Template de variáveis de ambiente (Preencha com sua chave no servidor ou .env local)
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"
GEMINI_MODEL="gemini-3.5-flash-lite"
PORT=8000

# Segurança / Autenticação de Administrador (MFA / TOTP)
# Se 'true', bloqueia scraping, execução de IA e modificações de banca para visitantes
READ_ONLY_MODE="true"
ADMIN_PASSWORD="SuaSenhaForteDeAdminAqui"
MFA_SECRET="SUA_CHAVE_BASE32_GERADA_PELO_SETUP_MFA" # Gerada executando: uv run python scripts/setup_mfa.py
ADMIN_SECRET="OpcionalParaScriptsCLI"
